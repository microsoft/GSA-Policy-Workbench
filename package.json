{
  "name": "gsa-policy-admin",
  "version": "0.0.0",
  "private": true,
  "description": "A single-pane policy management workbench for Microsoft Global Secure Access (GSA) Internet Access.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:dev": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.28.1",
    "@azure/msal-react": "^2.2.0",
    "@fluentui/react-components": "^9.54.0",
    "@fluentui/react-icons": "^2.0.270",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.11.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
